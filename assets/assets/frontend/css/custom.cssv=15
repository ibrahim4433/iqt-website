/* ========================================
   FIXED NAVBAR - Modern Glass Effect
   ======================================== */
#header {
    background: rgba(10, 14, 18, 0.92) !important;
    backdrop-filter: blur(12px) !important;
    border-bottom: 1px solid var(--border) !important;
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    width: 100% !important;
    z-index: 9999 !important;
    padding: 0 !important;
}

/* Header inner container spacing */
#header .container {
    padding-top: 12px !important;
    padding-bottom: 12px !important;
}

/* Adjust main content to account for fixed header */
.fixed-top-margin,
main:first-of-type,
#main,
.page-content,
.content-wrapper {
    margin-top: var(--header-height) !important;
}

/* For pages without fixed-top-margin class */
body > main:first-of-type,
body > .page-content,
body > .content-wrapper {
    margin-top: var(--header-height) !important;
}

/* Mobile adjustment */
@media (max-width: 768px) {
    :root {
        --header-height: 65px;
    }
}



/* Logo sizing */
#header .logo img {
    max-height: 45px !important;
    width: auto !important;
}

/* ========================================
   CARDS - Modern Glass/Solid Hybrid
   ======================================== */
.card,
.services .card,
.solutions .card,
.service-card,
.solution-card {
    background: var(--bg-card) !important;
    border: 1px solid var(--border) !important;
    border-radius: 16px !important;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.card:hover,
.services .card:hover,
.solutions .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
    border-color: var(--primary) !important;
}

/* ========================================
   BUTTONS - Gradient Modern
   ======================================== */
.btn-theme,
.btn-primary,
.btn-custom {
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%) !important;
    border: none !important;
    border-radius: 8px !important;
    padding: 12px 28px !important;
    font-weight: 600;
    letter-spacing: 0.5px;
    transition: all 0.3s ease;
    color: white !important;
}

.btn-theme:hover,
.btn-primary:hover,
.btn-custom:hover {
    background: linear-gradient(135deg, var(--accent) 0%, var(--primary) 100%) !important;
    transform: scale(1.02);
    box-shadow: 0 8px 20px rgba(0, 212, 184, 0.3);
}

