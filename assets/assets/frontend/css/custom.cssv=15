    top: 0;
    animation: header 1s ease-out;
    padding: 8px 0;
}

#header.header-scrolled{
    animation: header-scrolled .7s ease-out;
}

@keyframes header-scrolled{
    0%{
        top: -86px;
    }100%{
        top: 0;
    }
}
@keyframes header{
    0%{
        opacity: 0;
    }100%{
        opacity: 1;
    }
}

#header .logo img{
    margin: 0;
    width: 300px;
    max-height: none;
}

.logo-fixed,
#header.header-scrolled .logo{
    display: none;
}

#header.header-scrolled .logo-fixed{
